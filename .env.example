# ============================================================================
#  yearly-book — contoh konfigurasi
# ----------------------------------------------------------------------------
#  Isi langkah demi langkah:
#      1. cp .env.example .env
#      2. Isi bagian "WAJIB" di bawah.
#      3. docker compose up --build
#
#  PENTING
#  - File ini berisi NILAI CONTOH SAJA. Tidak ada secret asli di sini.
#  - .env sudah masuk .gitignore. JANGAN PERNAH di-commit.
#  - Kalau .env tidak ada sama sekali, `docker compose up --build` TETAP jalan:
#    scripts/dev-start.sh mengisi DATABASE_URL, AUTH_SECRET, dan kredensial admin
#    secara acak, lalu menuliskannya kembali ke .env dan mencetak username +
#    password ke log container. Jadi langkah `cp` di atas opsional.
#
#  Dua pembaca .env yang saling bertentangan — kenapa hash di-base64:
#  Docker Compose (env_file) meng-interpolasi karakter '$', sedangkan Next.js
#  membaca .env apa adanya tanpa escape. Hash bcrypt selalu diawali
#  "$2b$12$...", jadi bentuk mentah akan terpotong di salah satu sisi dan
#  login SELALU gagal. Base64 tidak mengandung '$', aman untuk keduanya.
# ============================================================================


# ############################################################################
# #  WAJIB
# ############################################################################

# --- Database (SQLite) -------------------------------------------------------
# Path absolut ke dalam Docker volume `db_data` (di-mount ke /data).
# Sengaja BUKAN ./prisma/dev.db supaya file database tidak pernah bocor ke
# host melalui bind mount source code.
#
# Bila muncul error SQLITE_BUSY, batasi jumlah koneksi:
#   DATABASE_URL="file:/data/dev.db?connection_limit=1"
DATABASE_URL="file:/data/dev.db"


# --- Auth.js v5 --------------------------------------------------------------
# Penerus NEXTAUTH_SECRET pada v4. Generate acak minimal 32 karakter:
#   docker compose run --rm app node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Nilai yang sama persis wajib dipakai di semua instance; kalau berubah, semua
# sesi yang sedang login akan logout.
AUTH_SECRET=""

# WAJIB "true": aplikasi berjalan di belakang reverse proxy (Cloudflare Tunnel),
# bukan di Vercel. Salah set = Auth.js menolak Host dari request.
AUTH_TRUST_HOST="true"

# URL publik aplikasi, TANPA garis miring di akhir.
#
# Auth.js memakainya untuk redirect setelah login dan untuk menentukan apakah
# cookie sesi diberi flag Secure. Kosongkan hanya untuk dev lokal — Auth.js
# lalu menebak dari Host request, yang benar untuk localhost.
#
#   produksi : https://subdomain.domain-anda.tld
#   lokal    : http://localhost:8003   (port hasil publish di docker-compose.yml)
#
# PENTANG: cookie session terikat pada domain ini. Login dari domain lain
# selalu gagal walaupun password benar.
AUTH_URL=""


# ############################################################################
# #  KREDENSIAL ADMIN
# ############################################################################
# Username admin. Jangan memakai "admin" di produksi.
#
# Biarkan kosong bila ingin dibiarkan sistem yang membuatkannya: saat start,
# scripts/dev-start.sh akan membuat username + password acak, mencetak
# kredensialnya ke log container, dan hanya menyimpan hash-nya ke .env.
AUTH_ADMIN_USERNAME=""

# Hash bcrypt dari password admin, bentuk BASE64.
# Password aslinya tidak pernah disimpan, hanya hash-nya.
#
# Buat hash (password dibaca dari env lalu dibuang, tidak masuk file):
#   docker compose run --rm -e AUTH_ADMIN_PASSWORD='password-anda' app npm run auth:hash
# Salin persis nilai yang dicetak, jangan diubah.
#
# Untuk mengganti password yang sudah terpasang (nilai lama tidak pernah
# dicetak ke mana pun):
#   ./scripts/reset-admin-password.sh
AUTH_ADMIN_PASSWORD_HASH_B64=""


# --- Opsional: login admin lewat Google -------------------------------------
#
# Halaman /admin bisa login dengan akun Google, TANPA password. Buku publik dan
# export PDF tetap terbuka untuk siapa saja — Google hanya melindungi /admin.
#
# Yang perlu disiapkan lebih dulu di https://console.cloud.google.com :
#   1. Buat project, lalu aktifkan "Google Identity Platform" (atau APIs &
#      Services > Credentials).
#   2. Credentials > Create Credentials > OAuth client ID > Application type:
#      "Web application".
#   3. Isi "Authorized redirect URIs" dengan nilai di bawah (WAJIB persis,
#      termasuk garis miring di akhir). Tambahkan satu URI per domain:
#        produksi : https://domain-anda.tld/api/auth/callback/google
#        lokal    : http://localhost:8003/api/auth/callback/google
#   4. Salin Client ID & Client Secret ke dua baris di bawah.
#
# Auth.js membaca kedua nilai ini otomatis, tidak perlu disentuh di auth.ts.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Daftar email yang BOLEH masuk sebagai admin lewat Google. Pisahkan dengan
# koma bila lebih dari satu. Huruf besar/kecil tidak berpengaruh.
#
# INI ADALAH SATU-SATUNYA TEMPAT untuk menambah atau mencabut admin Google.
# Email yang tidak ada di sini tetap bisa menyelesaikan login di Google, tapi
# Auth.js menolaknya dan mengembalikannya ke /login?error=AccessDenied.
#
# Jangan menulis "semua email boleh" — begitu provider ini aktif, siapa pun
# yang punya akun Google bisa masuk ke alur OAuth, jadi daftarnya harus
# dibatasi eksplisit.
#
# Setelah mengubah nilai di sini, WAJIB recreate container supaya env_file
# dibaca ulang:
#     docker compose up -d --force-recreate app
# `docker compose restart` TIDAK cukup — lihat AGENTS.md §8.2.
AUTH_ADMIN_EMAIL=""


# ############################################################################
# #  OPSIONAL — punya default yang benar, tidak perlu diisi
# ############################################################################

# --- Upload foto -------------------------------------------------------------
# Folder di disk tempat foto hasil upload ditulis. Di setup ini foldernya
# Docker volume `uploads`, bukan bind mount ke host, sehingga foto tidak
# menumpuk di mesin dan tetap ada saat container di-recreate.
UPLOAD_DIR="/app/public/uploads"

# Awalan URL publik untuk menyajikan foto.
#
# Prefix ini ditangani route app/media/[...path]/route.ts yang membaca disk
# tiap request — BUKAN file statis public/. Alasannya: Next.js menyusun daftar
# file public/ saat start, sehingga upload yang dilakukan setelah start akan
# membalas 404 di produksi.
UPLOAD_URL_PREFIX="/media"

# Batas ukuran satu berkas unggahan, dalam byte. 5 MB.
UPLOAD_MAX_BYTES="5242880"

# --- Branding ---------------------------------------------------------------
# Nama aplikasi untuk judul halaman. Di-inline saat build (prefix NEXT_PUBLIC_),
# jadi mengubahnya memerlukan container di-rebuild.
NEXT_PUBLIC_APP_NAME="yearly-book"
